# Sample settings for agent.py. These mirror the command-line flags;
# the script reads flags, so use this as a copy-paste reference.

# The ngx-l402 gateway to buy from.
GATEWAY_URL=http://localhost:8000
PAID_PATH=/protected

# --payer lnd-rest : an LND node the agent pays from.
LND_REST_URL=https://127.0.0.1:8080
# hex-encoded macaroon with send permission:  xxd -ps -c2000 admin.macaroon
LND_MACAROON_HEX=
