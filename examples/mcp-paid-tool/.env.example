# ngx-l402 gateway the agent buys from.
L402_GATEWAY=http://localhost:8000

# LND node the server pays invoices from (needs send permission).
LND_REST_URL=https://127.0.0.1:8080
# xxd -ps -c2000 admin.macaroon
LND_MACAROON_HEX=
# Set to any value to skip TLS verification (self-signed regtest certs).
LND_NO_VERIFY=1
